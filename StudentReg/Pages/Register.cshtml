@page
@model StudentRegistration.Pages.RegisterModel
<h2>Student Registration Form</h2>
<form method="post">
    
        <label>Name:</label>
        <input asp-for="Student.Name" />
        <span asp-validation-for="Student.Name" style="color:red"></span><br /><br />

        <label>ID:</label>
        <input asp-for="Student.ID" />
        <span asp-validation-for="Student.ID" style="color:red"></span><br /><br />

        <label>Email:</label>
        <input asp-for="Student.Email" />
        <span asp-validation-for="Student.Email" style="color:red"></span><br /><br />

        <label>Age:</label>
        <input asp-for="Student.Age" />
        <span asp-validation-for="Student.Age" style="color:red"></span><br /><br />

    <button type="submit">Submit</button>
</form>


@if (Model.Message != null)
{
        <p style="color:green">@Model.Message</p>

}
